{
  "title": "Мини-магазин — мониторинг",
  "uid": "mini-shop-main",
  "refresh": "5s",
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Запросы в секунду по маршрутам",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [{ "expr": "sum by (route) (rate(app_requests_total[30s]))", "refId": "A" }]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Время ответа p95",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le, route) (rate(app_request_duration_seconds_bucket[30s])))", "refId": "A" }]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Нагрузка по воркерам",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [{ "expr": "sum by (instance) (rate(app_requests_total[30s]))", "refId": "A" }]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Доля попаданий в кэш Redis",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit" } },
      "targets": [{ "expr": "sum(rate(app_cache_total{result=\"hit\"}[30s])) / sum(rate(app_cache_total[30s]))", "refId": "A" }]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Сообщения в очереди RabbitMQ",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [{ "expr": "sum(rabbitmq_queue_messages_ready)", "refId": "A" }]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Соединения PostgreSQL",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [{ "expr": "sum by (state) (pg_stat_activity_count{datname=\"shop\"})", "refId": "A" }]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Ошибки сервера (5xx)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [{ "expr": "sum by (route, status) (rate(app_requests_total{status=~\"5..\"}[30s]))", "refId": "A" }]
    }
  ]
}
